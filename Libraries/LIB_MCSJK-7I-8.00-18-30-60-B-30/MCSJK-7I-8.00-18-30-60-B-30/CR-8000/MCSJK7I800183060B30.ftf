(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r200_120
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 120000)
            (height 200000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r200_120
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r200_120))
          (noconnect (pad r200_120))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r200_120))
          (noconnect (pad r200_120))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r200_120))
          (noconnect (pad r200_120))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "MCSJK7I800183060B30"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -250000 160000
                        (width 10000)
                      )
                      (pt 250000 160000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 250000 160000
                        (width 10000)
                      )
                      (pt 250000 -160000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 250000 -160000
                        (width 10000)
                      )
                      (pt -250000 -160000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -250000 -160000
                        (width 10000)
                      )
                      (pt -250000 160000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 385000 270000)
                    (pt 385000 -270000)
                    (pt -385000 -270000)
                    (pt -385000 270000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -60000 160000
                        (width 20000)
                      )
                      (pt 60000 160000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -60000 -160000
                        (width 20000)
                      )
                      (pt 60000 -160000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -200000 -220000
                        (width 10000)
                      )
                      (pt -200000 -220000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -200000 -220000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt -200000 -230000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -200000 -230000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt -200000 -220000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -185000 -110000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 -110000)
                  (angle 90)
                  (padstackGroup default (padstack r200_120))
                )
              )
            )
          )
          (pin 2
            (pt 185000 -110000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 -110000)
                  (angle 90)
                  (padstackGroup default (padstack r200_120))
                )
              )
            )
          )
          (pin 3
            (pt 185000 110000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 185000 110000)
                  (angle 90)
                  (padstackGroup default (padstack r200_120))
                )
              )
            )
          )
          (pin 4
            (pt -185000 110000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -185000 110000)
                  (angle 90)
                  (padstackGroup default (padstack r200_120))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape MCSJK-7I-8.00-18-30-60-B-30.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

